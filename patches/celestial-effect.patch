diff --git a/app/src/terminal/cursor_signal.rs b/app/src/terminal/cursor_signal.rs
new file mode 100644
index 000000000..45ada9b35
--- /dev/null
+++ b/app/src/terminal/cursor_signal.rs
@@ -0,0 +1,52 @@
+use warpui::color::ColorU;
+use warpui::geometry::rect::RectF;
+use warpui::geometry::vector::Vector2F;
+use warpui::PaintContext;
+
+use super::color::OverrideList;
+use super::model::ansi::color_index;
+
+fn signal_color(override_colors: &OverrideList, pane_is_focused: bool) -> Option<ColorU> {
+    if !pane_is_focused {
+        return None;
+    }
+
+    override_colors[color_index::CURSOR].map(|color| ColorU::new(color.r, color.g, color.b, 0))
+}
+
+/// Publish an invisible, focused-pane marker that the window renderer can decode.
+///
+/// The zero-sized, transparent marker remains present when Warp hides the terminal
+/// cursor for CLI rich input and cannot be confused with an unfocused split's cursor.
+pub fn publish_focused_pane_signal(
+    override_colors: &OverrideList,
+    pane_is_focused: bool,
+    ctx: &mut PaintContext,
+) {
+    let Some(color) = signal_color(override_colors, pane_is_focused) else {
+        return;
+    };
+
+    ctx.scene
+        .draw_rect_without_hit_recording(RectF::new(Vector2F::zero(), Vector2F::zero()))
+        .with_background(color);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn signal_is_transparent_and_limited_to_the_focused_pane() {
+        let signed_color = ColorU::new(0xF1, 0xBC, 0x08, 255);
+        let mut override_colors = OverrideList::empty();
+        override_colors[color_index::CURSOR] = Some(signed_color);
+
+        assert_eq!(signal_color(&override_colors, false), None);
+        assert_eq!(
+            signal_color(&override_colors, true),
+            Some(ColorU::new(0xF1, 0xBC, 0x08, 0))
+        );
+        assert_eq!(signal_color(&OverrideList::empty(), true), None);
+    }
+}
