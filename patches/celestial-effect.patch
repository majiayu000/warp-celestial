@@ -0,0 +1,112 @@
+use std::time::Duration;
+
+use instant::Instant;
+use warpui_core::scene::Scene;
+
+const SIGNAL_GRACE: Duration = Duration::from_millis(900);
+const GLIDE_MIN_SECONDS: f32 = 0.3;
+const GLIDE_MAX_SECONDS: f32 = 1.5;
+const GLIDE_SECONDS_PER_LEVEL: f32 = 10.0;
+const SETTLED_EPSILON: f32 = 0.0005;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(super) enum CelestialQuality {
+    Auto,
+    Low,
+    Balanced,
+    High,
+}
+
+impl CelestialQuality {
+    pub(super) fn from_name(name: &str) -> Option<Self> {
+        match name {
+            "auto" => Some(Self::Auto),
+            "low" => Some(Self::Low),
+            "balanced" => Some(Self::Balanced),
+            "high" => Some(Self::High),
+            _ => None,
+        }
+    }
+
+    pub(super) fn trace_steps(self, fill: f32) -> u32 {
+        match self {
+            Self::Auto if fill < 0.35 => 24,
+            Self::Auto if fill < 0.75 => 36,
+            Self::Auto => 48,
+            Self::Low => 24,
+            Self::Balanced => 36,
+            Self::High => 48,
+        }
+    }
+}
+
+pub(super) fn parse_demo_fill(value: Option<&str>) -> Result<Option<f32>, String> {
+    let Some(value) = value else {
+        return Ok(None);
+    };
+    let fill = value
+        .parse::<f32>()
+        .map_err(|error| format!("Invalid WARP_CELESTIAL_DEMO={value:?}: {error}"))?;
+    if !fill.is_finite() || !(0.0..=1.0).contains(&fill) {
+        return Err(format!(
+            "Invalid WARP_CELESTIAL_DEMO={value:?}; expected a number from 0 to 1"
+        ));
+    }
+    Ok(Some(fill))
+}
+
+pub(super) struct CelestialState {
+    current_fill: f32,
+    target_fill: f32,
+    last_signal: Option<Instant>,
+    last_update: Instant,
+}
+
+impl CelestialState {
+    pub(super) fn new(now: Instant) -> Self {
+        Self {
+            current_fill: 0.0,
+            target_fill: 0.0,
+            last_signal: None,
+            last_update: now,
+        }
+    }
+
+    pub(super) fn update(&mut self, scene: &Scene, now: Instant) -> f32 {
+        if let Some(fill) = scene.signed_cursor_fill() {
+            self.target_fill = fill.clamp(0.0, 1.0);
+            self.last_signal = Some(now);
+        } else if self
+            .last_signal
+            .is_none_or(|last_signal| now.saturating_duration_since(last_signal) > SIGNAL_GRACE)
+        {
+            self.target_fill = 0.0;
+        }
+
+        let elapsed = now
+            .saturating_duration_since(self.last_update)
+            .as_secs_f32()
+            .min(0.1);
+        self.last_update = now;
+
+        let distance = (self.target_fill - self.current_fill).abs();
+        if distance <= SETTLED_EPSILON {
+            self.current_fill = self.target_fill;
+            return self.current_fill;
+        }
+
+        let glide_seconds =
+            (distance * GLIDE_SECONDS_PER_LEVEL).clamp(GLIDE_MIN_SECONDS, GLIDE_MAX_SECONDS);
+        let blend = 1.0 - (-4.6 * elapsed / glide_seconds).exp();
+        self.current_fill += (self.target_fill - self.current_fill) * blend;
+        self.current_fill.clamp(0.0, 1.0)
+    }
+
+    pub(super) fn is_active(&self) -> bool {
+        self.current_fill > SETTLED_EPSILON || self.target_fill > SETTLED_EPSILON
+    }
+}
+
+#[cfg(test)]
+#[path = "celestial_tests.rs"]
+mod tests;
