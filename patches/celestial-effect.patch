diff --git a/crates/warpui/src/platform/mac/window.rs b/crates/warpui/src/platform/mac/window.rs
index ec68a4897..d84185ce6 100644
--- a/crates/warpui/src/platform/mac/window.rs
+++ b/crates/warpui/src/platform/mac/window.rs
@@ -1452,6 +1452,21 @@ extern "C-unwind" fn warp_update_layer(this: &Object) {
             renderer.render(&scene, window.as_ref(), ctx.font_cache());
         });
 
+        // Blackhole animation: Warp only redraws on dirty events, so a static
+        // scene (like the login screen) would freeze the shader's `time` and
+        // leave the accretion disk standing still. While the effect is active we
+        // re-request a frame, so the next vsync re-runs render() with an
+        // advanced time and the disk swirls. This stops on its own once the fill
+        // level returns to 0.
+        //
+        // Preserve `next_scene` between animation frames. `request_redraw()` is
+        // for invalidated UI and deliberately clears that cache; the celestial
+        // effect only needs another Metal presentation of the same scene.
+        // SAFETY: messaging the valid window owned by this WindowState.
+        if renderer.blackhole_active() {
+            let _: () = msg_send![window.window(), setNeedsDisplayAsync];
+        }
+
         app::callback_dispatcher()
             .for_window(&Window(window.clone()))
             .frame_drawn();
diff --git a/crates/warpui_core/src/scene.rs b/crates/warpui_core/src/scene.rs
index 98b7dba7d..4e27d65d1 100644
--- a/crates/warpui_core/src/scene.rs
+++ b/crates/warpui_core/src/scene.rs
@@ -687,6 +687,41 @@ impl Scene {
     pub fn rendering_config(&self) -> &rendering::Config {
         &self.rendering_config
     }
+
+    /// Decode the signed Claude context value carried by the invisible marker
+    /// published by the focused terminal pane.
+    pub fn signed_cursor_fill(&self) -> Option<f32> {
+        self.overlay_layers
+            .iter()
+            .rev()
+            .chain(self.layers.iter().rev())
+            .flat_map(|layer| layer.rects.iter().rev())
+            .find_map(|rect| match rect.background {
+                Fill::Solid(color) => decode_signed_cursor_fill(color),
+                Fill::None | Fill::Gradient { .. } => None,
+            })
+    }
+}
+
+fn decode_signed_cursor_fill(color: ColorU) -> Option<f32> {
+    if color.a != 0 {
+        return None;
+    }
+
+    let high_nibbles = (color.r >> 4, color.g >> 4, color.b >> 4);
+    if high_nibbles != (0xF, 0xB, 0x0) {
+        return None;
+    }
+
+    let red = color.r & 0xF;
+    let high = color.g & 0xF;
+    let low = color.b & 0xF;
+    if red != (high ^ low ^ 0x5) {
+        return None;
+    }
+
+    let encoded = (high << 4) | low;
+    (encoded <= 250).then_some(encoded as f32 / 250.0)
 }
 
