+use instant::Instant;
+use pathfinder_color::ColorU;
+use pathfinder_geometry::rect::RectF;
+use pathfinder_geometry::vector::vec2f;
+use warpui_core::rendering;
+use warpui_core::scene::Scene;
+
+use super::{parse_demo_fill, CelestialQuality, CelestialState, SIGNAL_GRACE};
+
+fn scene_with_fill(fill: f32) -> Scene {
+    let encoded = (fill.clamp(0.0, 1.0) * 250.0).round() as u8;
+    let high = encoded >> 4;
+    let low = encoded & 0xF;
+    let color = ColorU::new(0xF0 | (high ^ low ^ 0x5), 0xB0 | high, low, 0);
+    let mut scene = Scene::new(1.0, rendering::Config::default());
+    scene
+        .draw_rect_with_hit_recording(RectF::new(vec2f(0.0, 0.0), vec2f(10.0, 20.0)))
+        .with_background(color);
+    scene
+}
+
+#[test]
+fn glides_toward_cursor_fill_instead_of_jumping() {
+    let start = Instant::now();
+    let mut state = CelestialState::new(start);
+    let fill = state.update(
+        &scene_with_fill(0.8),
+        start + std::time::Duration::from_millis(100),
+    );
+
+    assert!(fill > 0.0);
+    assert!(fill < 0.8);
+    assert!(state.is_active());
+}
+
+#[test]
+fn brief_missing_cursor_signal_survives_blink() {
+    let start = Instant::now();
+    let mut state = CelestialState::new(start);
+    state.update(
+        &scene_with_fill(0.5),
+        start + std::time::Duration::from_millis(100),
+    );
+    let empty = Scene::new(1.0, rendering::Config::default());
+    let during_blink = state.update(
+        &empty,
+        start + SIGNAL_GRACE - std::time::Duration::from_millis(1),
+    );
+
+    assert!(during_blink > 0.0);
+    assert!(state.is_active());
+}
+
+#[test]
+fn missing_signal_fades_out_after_grace_period() {
+    let start = Instant::now();
+    let mut state = CelestialState::new(start);
+    state.update(
+        &scene_with_fill(0.5),
+        start + std::time::Duration::from_millis(100),
+    );
+    let before_fade = state.current_fill;
+    let empty = Scene::new(1.0, rendering::Config::default());
+    let after_fade = state.update(
+        &empty,
+        start + SIGNAL_GRACE + std::time::Duration::from_millis(200),
+    );
+
+    assert!(after_fade < before_fade);
+}
+
+#[test]
+fn quality_names_map_to_bounded_trace_steps() {
+    assert_eq!(
+        CelestialQuality::from_name("low").unwrap().trace_steps(1.0),
+        24
+    );
+    assert_eq!(
+        CelestialQuality::from_name("balanced")
+            .unwrap()
+            .trace_steps(0.0),
+        36
+    );
+    assert_eq!(
+        CelestialQuality::from_name("high").unwrap().trace_steps(0.0),
+        48
+    );
+    assert_eq!(CelestialQuality::from_name("turbo"), None);
+}
+
+#[test]
+fn automatic_quality_tracks_context_fill_at_deterministic_boundaries() {
+    let quality = CelestialQuality::from_name("auto").unwrap();
+    assert_eq!(quality.trace_steps(0.0), 24);
+    assert_eq!(quality.trace_steps(0.349), 24);
+    assert_eq!(quality.trace_steps(0.35), 36);
+    assert_eq!(quality.trace_steps(0.749), 36);
+    assert_eq!(quality.trace_steps(0.75), 48);
+    assert_eq!(quality.trace_steps(1.0), 48);
+}
+
+#[test]
+fn demo_fill_is_explicit_and_bounded() {
+    assert_eq!(parse_demo_fill(None).unwrap(), None);
+    assert_eq!(parse_demo_fill(Some("0.65")).unwrap(), Some(0.65));
+    assert!(parse_demo_fill(Some("1.1")).is_err());
+    assert!(parse_demo_fill(Some("not-a-number")).is_err());
+}
