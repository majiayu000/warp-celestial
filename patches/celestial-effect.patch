+
+// ---- Celestial post-process pass ----
+//
+// A full-screen pass that overlays an animated celestial effect on top of the
+// rendered terminal scene. The vertex stage is shared; the specific look is
+// chosen by which fragment function the pipeline is built with
+// (blackhole_fragment / sun_fragment). All effects read the same EffectUniforms.
+
+struct EffectFragmentData
+{
+    float4 position [[position]];
+    float2 uv;
+};
+
+vertex EffectFragmentData
+effect_vertex(uint vertex_id [[vertex_id]])
+{
+    float2 p = float2(float((vertex_id << 1) & 2), float(vertex_id & 2)); // (0,0) (2,0) (0,2)
+    EffectFragmentData out;
+    out.position = float4(p * 2.0 - 1.0, 0.0, 1.0);
+    // y-down UV so that uv.y=0 is the top of the screen, matching the framebuffer row order.
+    out.uv = float2(p.x, 1.0 - p.y);
+    return out;
+}
+
+fragment float4 blackhole_fragment(
+    EffectFragmentData in [[stage_in]],
+    texture2d<float> scene_texture [[texture(0)]],
+    constant EffectUniforms *uniforms [[buffer(0)]])
+{
+    constexpr sampler scene_sampler(address::clamp_to_edge, filter::linear);
+    float fill = saturate(uniforms->fill);
+    float time = uniforms->time;
+    // No active session / no data: pass through the scene unchanged.
+    if (fill <= 0.0) {
+        return scene_texture.sample(scene_sampler, in.uv);
+    }
+
+    // Work in aspect-corrected "square" coordinates where 1 unit == the full
+    // screen height. Computing the radius here (instead of in raw 0..1 UV)
+    // makes the shadow and rings render as true circles on any window shape.
+    float aspect = uniforms->viewport_size.x / max(uniforms->viewport_size.y, 1.0);
+
+    // The blackhole's center drifts around the screen on a slow Lissajous path:
+    // two incommensurate frequencies plus a phase offset make it wander
+    // up/down/left/right rather than tracing a circle or a straight line. The
+    // amplitude is a fraction of the screen height, small enough to stay on
+    // screen yet clearly mobile.
+    float2 center = float2(
+        0.22 * sin(time * 0.60),
+        0.22 * sin(time * 0.40 + 2.0));
+
+    // Position relative to the (moving) blackhole center, in square space.
+    float2 p = float2((in.uv.x - 0.5) * aspect, in.uv.y - 0.5) - center;
+    float r = length(p);
+    float2 dir = p / max(r, 0.0001);
+
+    // The shadow/horizon grows with the fill level (kept deliberately compact).
+    float r_shadow = 0.03 + 0.05 * fill;
+    float r_ring = r_shadow * 1.5;
+
+    // Gravitational lensing: deflect the sample coordinate outward (in square
+    // space, relative to the hole) so the background wraps around the shadow,
+    // then map back into screen UV for the lookup — adding the hole's offset
+    // back in so the lens tracks the moving center correctly.
+    float bend = (r_shadow * r_shadow) / max(r, r_shadow * 0.5);
+    float2 p_lens = p + dir * (bend * 0.6);
+    float2 lens_uv = float2((p_lens.x + center.x) / aspect + 0.5, (p_lens.y + center.y) + 0.5);
+    lens_uv = clamp(lens_uv, 0.0, 1.0);
+    float3 bg = scene_texture.sample(scene_sampler, lens_uv).rgb;
+
+    // Einstein-ring glow: brighten the lensed background just inside the disk.
+    bg *= 1.0 + 0.35 * smoothstep(r_ring * 1.3, r_ring * 0.9, r);
+
+    // Relativistic Doppler beaming: the side of the disk rotating toward the
+    // viewer is noticeably brighter — the signature EHT crescent. It stays fixed
+    // in screen space (it is set by the disk's orientation) while matter flows
+    // through it, so it reads as a stable bright lobe with structure rotating
+    // beneath it.
+    float beam = mix(0.30, 1.25, 0.5 + 0.5 * (-dir.x));
+
+    // Polar angle, used for everything that rotates.
+    float ang = atan2(dir.y, dir.x);
+
+    // Orbital motion — quick enough to read as clearly alive at a glance, but
+    // not frantic. (~4 s per turn.)
+    float spin = time * 1.6;
+
+    // Two spiral arms of infalling matter that rotate around the shadow.
+    float arms = 0.55 + 0.45 * sin(ang * 2.0 - spin + r * 22.0);
+
+    // Turbulent flicker: the accretion plasma is chaotic, so its brightness
+    // shimmers. A few incommensurate frequencies keep it from reading as a
+    // clean mechanical pulse; amplitude is deliberately modest.
+    float flicker = 1.0
+        + 0.14 * sin(ang * 3.0 + time * 5.0)
+        + 0.10 * sin(ang * 7.0 - time * 3.3 + r * 40.0)
+        + 0.08 * sin(time * 8.1 + r * 90.0);
+
+    // Accretion disk: thin, hot ring, white-hot core fading to amber, carved by
+    // the arms and shimmering with turbulence.
+    float disk = exp(-pow((r - r_ring) / 0.014, 2.0)) * arms;
+    float3 disk_hot = float3(1.0, 0.95, 0.85);
+    float3 disk_cool = float3(1.0, 0.55, 0.18);
+    float3 disk_col = mix(disk_hot, disk_cool, smoothstep(r_ring - 0.02, r_ring + 0.03, r));
+    float3 col = bg + disk_col * disk * 3.0 * fill * beam * flicker;
+
+    // A bright hotspot orbiting the ring (a clump of matter), so the spin is obvious.
+    float d_ang = atan2(sin(ang - spin), cos(ang - spin));
+    float beacon = exp(-pow(d_ang / 0.4, 2.0)) * exp(-pow((r - r_ring) / 0.018, 2.0));
+    col += float3(1.0, 0.92, 0.75) * beacon * 3.5 * fill;
+
+    // Inner photon ring: razor-thin, near-white, with a faint slow pulse.
+    float photon = exp(-pow((r - r_shadow * 1.12) / 0.0045, 2.0));
+    col += float3(1.0, 0.92, 0.8) * photon * 2.0 * fill * (1.0 + 0.12 * sin(time * 2.0));
+
+    // Event horizon: pure black shadow with a crisp edge.
+    float horizon = smoothstep(r_shadow, r_shadow * 0.96, r);
+    col = mix(col, float3(0.0), horizon);
+
+    // Fade the whole effect in/out based on fill.
+    float effect_alpha = saturate(fill * 1.6);
+    float3 original = scene_texture.sample(scene_sampler, in.uv).rgb;
+    return float4(mix(original, col, effect_alpha), 1.0);
+}
+
+// ---- Noise helpers (organic, non-banded texture for the sun) ----
+// Sin-based patterns read as fake and banded; value noise + fbm give the
+// boiling surface and irregular corona that make a star look real.
+
+float cel_hash(float2 p)
+{
+    p = fract(p * float2(123.34, 456.21));
+    p += dot(p, p + 45.32);
+    return fract(p.x * p.y);
+}
+
+float cel_noise(float2 p)
+{
+    float2 i = floor(p);
+    float2 f = fract(p);
+    float2 u = f * f * (3.0 - 2.0 * f);
+    float a = cel_hash(i);
+    float b = cel_hash(i + float2(1.0, 0.0));
+    float c = cel_hash(i + float2(0.0, 1.0));
+    float d = cel_hash(i + float2(1.0, 1.0));
+    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
+}
+
+float cel_fbm(float2 p)
+{
+    float v = 0.0;
+    float amp = 0.5;
+    for (int i = 0; i < 4; i++) {
+        v += amp * cel_noise(p);
+        p *= 2.02;
+        amp *= 0.5;
+    }
+    return v;
+}
+
+// A realistic glowing sun: a limb-darkened (spherically shaded) photosphere with
+// boiling noise granulation, a soft irregular corona, and noise-driven pulsing
+// active regions. Size and intensity track `fill`; it drifts like the blackhole.
+// It emits light (additive) rather than swallowing it; no gravitational lensing.
+fragment float4 sun_fragment(
+    EffectFragmentData in [[stage_in]],
+    texture2d<float> scene_texture [[texture(0)]],
+    constant EffectUniforms *uniforms [[buffer(0)]])
+{
+    constexpr sampler scene_sampler(address::clamp_to_edge, filter::linear);
+    float3 original = scene_texture.sample(scene_sampler, in.uv).rgb;
+    float fill = saturate(uniforms->fill);
+    if (fill <= 0.0) {
+        return float4(original, 1.0);
+    }
+    float time = uniforms->time;
+
+    // Aspect-corrected square space; same gentle wander as the blackhole.
+    float aspect = uniforms->viewport_size.x / max(uniforms->viewport_size.y, 1.0);
+    float2 center = float2(
+        0.22 * sin(time * 0.60),
+        0.22 * sin(time * 0.40 + 2.0));
+    float2 p = float2((in.uv.x - 0.5) * aspect, in.uv.y - 0.5) - center;
+    float r = length(p);
+    float ang = atan2(p.y, p.x);
+    float2 circ = float2(cos(ang), sin(ang)); // seamless angular coordinate
+
+    // Bold, close-up sun that scales strongly with activity.
+    float r_sun = (0.05 + 0.11 * fill) * (1.0 + 0.02 * sin(time * 1.5));
+    float rn = r / r_sun; // 0 center, 1 limb
+
+    float3 col = original;
+
+    // White-light corona: a faint smooth halo (real suns show little corona in
+    // white light), with only the gentlest wisp so it never reads as a starburst.
+    float wisp = 1.0 + 0.10 * cel_fbm(float2(ang * 4.0, rn * 3.0) + time * 0.10);
+    float corona = exp(-max(rn - 1.0, 0.0) / 0.35) * wisp;
+    col += float3(1.0, 0.42, 0.12) * corona * 0.6 * fill;
+
+    // Thin warm limb atmosphere (irregular so it's glowing gas, not a neon ring).
+    float limb_noise = 0.7 + 0.6 * cel_fbm(circ * 4.0 + float2(time * 0.15, -time * 0.1));
+    float chromo = exp(-pow((rn - 1.0) / 0.04, 2.0)) * limb_noise;
+    col += float3(1.0, 0.55, 0.18) * chromo * 1.0 * fill;
+
+    // Pulsing active regions near the limb (耀斑脉动), kept subtle.
+    float active = cel_fbm(circ * 3.5 + float2(-time * 0.2, time * 0.15));
+    active = smoothstep(0.62, 0.92, active);
+    float flare_pulse = 0.6 + 0.4 * sin(time * 2.5);
+    col += float3(1.0, 0.50, 0.16) * active * corona * flare_pulse * 0.8 * fill;
+
+    // Ejected embers / sparks: procedural particles flying off the limb and
+    // cooling as they travel. Faked in-shader (no particle buffer) by looping a
+    // fixed set, each with a hashed launch angle, speed, phase and reach. The
+    // radius cull skips the loop on pixels far from the sun to protect the frame
+    // rate.
+    if (r < r_sun * 3.0) {
+        for (int i = 0; i < 32; i++) {
+            float fi = float(i);
+            float a0 = cel_hash(float2(fi, 1.7)) * 6.2831853;
+            float spd = 0.15 + cel_hash(float2(fi, 3.1)) * 0.35;
+            float ph = cel_hash(float2(fi, 5.9));
+            float reach = 0.5 + cel_hash(float2(fi, 7.3)) * 1.2;
+            float tang = (cel_hash(float2(fi, 8.8)) - 0.5) * 0.8;
+            float life = fract(time * spd + ph);
+            float rad = r_sun * (1.0 + life * reach);
+            float a = a0 + tang * life;
+            float2 off = float2(cos(a), sin(a)) * rad;
+            float d = length(p - off);
+            float size = 0.0025 + 0.0025 * cel_hash(float2(fi, 2.2));
+            float dotp = exp(-(d * d) / (size * size));
+            float fade = smoothstep(0.0, 0.1, life) * (1.0 - life);
+            float3 pcol = mix(float3(1.0, 0.95, 0.7), float3(1.0, 0.35, 0.08), life);
+            col += pcol * dotp * fade * 2.5 * fill;
+        }
+    }
+
+    // Photosphere: vivid, limb-darkened disk with fine granulation plus larger
+    // mottling (supergranulation) and sunspots — the look of a real photo.
+    float mu = sqrt(max(1.0 - rn * rn, 0.0));
+    float limb = 0.35 + 0.65 * pow(mu, 0.45); // edge redder/dimmer (limb darkening)
+    float g = cel_fbm(p * 75.0 + float2(time * 0.12, -time * 0.25));
+    g = smoothstep(0.30, 0.72, g);            // crisp cells vs dark intergranular lanes
+    float gran = 0.55 + 0.65 * g;
+    float big = cel_fbm(p * 12.0 + time * 0.02); // large-scale mottling
+    float3 core_col = float3(1.0, 0.72, 0.24);
+    float3 mid_col = float3(1.0, 0.42, 0.07);
+    float3 limb_col = float3(0.62, 0.12, 0.02);
+    float t_limb = pow(1.0 - mu, 1.4);
+    float3 surf_col = mix(core_col, mid_col, smoothstep(0.0, 0.50, t_limb));
+    surf_col = mix(surf_col, limb_col, smoothstep(0.50, 1.0, t_limb));
+    surf_col *= limb * gran * (0.85 + 0.30 * big);
+
+    // Sunspots: dark umbra + softer penumbra + a faint faculae ring. Fixed on the
+    // disk and faded near the limb so they look like they sit on the sphere.
+    float2 dn = p / r_sun;
+    float sd1 = length(dn - float2(0.28, -0.18));
+    float sd2 = length(dn - float2(-0.34, 0.22));
+    float sd3 = length(dn - float2(0.05, 0.40));
+    float umbra = min(1.0, smoothstep(0.07, 0.02, sd1) + smoothstep(0.05, 0.015, sd2) + smoothstep(0.04, 0.012, sd3));
+    float penum = min(1.0, smoothstep(0.16, 0.05, sd1) + smoothstep(0.12, 0.04, sd2) + smoothstep(0.10, 0.03, sd3));
+    float spot_fade = smoothstep(0.10, 0.40, mu);
+    umbra *= spot_fade;
+    penum *= spot_fade;
+    surf_col *= mix(1.0, 0.55, penum) * mix(1.0, 0.15, umbra);
+    float fac = (smoothstep(0.20, 0.12, sd1) - smoothstep(0.10, 0.05, sd1)) * spot_fade;
+    surf_col += float3(1.0, 0.70, 0.30) * fac * 0.25 * mu;
+
+    surf_col += float3(1.0, 0.60, 0.20) * pow(g, 4.0) * 0.35 * mu; // warm hot cells
+    float surf = smoothstep(1.0, 0.97, rn);
+    col = mix(col, surf_col, surf);
+
+    float effect_alpha = saturate(fill * 1.6);
+    return float4(mix(original, col, effect_alpha), 1.0);
+}
